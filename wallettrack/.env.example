# ---------------------------------------------------------------------------
# WalletTrack environment
#
# Copy to .env.local and fill in. Every variable here is validated at boot by
# src/lib/env.ts, so a missing or malformed value fails fast with a clear
# message instead of surfacing as a mystery error on the first request.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wallettrack

# Session signing key for HS256. Must be at least 32 characters - a shorter key
# weakens the signature it is protecting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing this signs every existing session out.
AUTH_SECRET=replace-me-with-a-64-character-random-string

# Optional -------------------------------------------------------------------

# Database name, when it is not already part of MONGODB_URI.
# MONGODB_DB_NAME=wallettrack

# Session lifetime in seconds. Defaults to 7 days.
# SESSION_MAX_AGE=604800

# Contact form delivery. Leave unset to disable the form; it then returns a
# clear "unavailable" response rather than failing silently.
# For Gmail, use an App Password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# CONTACT_RECIPIENT_EMAIL=you@example.com
